# Servidor HTTP
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=development

# Base de datos PostgreSQL local o remota
# En producción Kamal inyectará: postgresql://<POSTGRES_USER>:<ENCODED_PASS>@infra-core-postgres:5432/oboeru_prod
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/oboeru_prod"

# Secreto para firma de tokens JWT / autenticación
AUTH_SECRET="reemplazar_con_openssl_rand_hex_32"

